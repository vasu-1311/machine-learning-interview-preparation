   "source": [
    "Question 13: What is Vectorization in NumPy?\n",
    "Easy answer:\n",
    "\n",
    "Vectorization means performing an operation on the whole array at once, instead of using a Python loop for each element."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a420ef66-9a48-47e5-bac3-25575057d9fa",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "numbers = np.array([1, 2, 3, 4])\n",
    "\n",
    "result = numbers * 2\n",
    "\n",
    "print(result)"
   ]
  }
